rules_version = '2';

// Mes Fleurs 芳澤秀花藝設計 - Firestore 安全規則
// 部署：firebase deploy --only firestore:rules（或貼到 Firebase Console → Firestore → 規則）
// 管理員 = Firebase Auth custom claim admin: true（用 GitHub Actions「設定管理員權限」設定）
//
// ⚠️ 這版規則禁止網頁端直接建立或修改訂單，發布前必須先部署這兩支 Cloud Function：
//    - createOrder（functions/create-order.js）：結帳頁建立訂單
//    - appendOrderNote（functions/append-order-note.js）：顧客追加備註／回報匯款
//    先 `firebase deploy --only functions` 部署完成，再發布這版規則，
//    否則顧客會無法下單、也無法回報匯款。
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // 登入者的手機號碼（+8869xxxxxxxx → 09xxxxxxxx，跟訂單上存的格式一致）
    function myPhone() {
      return request.auth.token.phone_number.replace('^\\+886', '0');
    }

    // 訂單記錄列表（orders.html）能不能看到這筆訂單：會員訂單看 userId；
    // 也可以用登入的信箱／手機找到以同一個信箱／手機下的訂單（例如登入前以訪客身分下的單）。
    // 注意：Firestore 規則不是篩選器，查詢條件必須能保證每一筆結果都符合規則，
    // 所以這裡不能再加「沒有 userId」之類查詢表達不出來的條件，否則
    // where('customer.email', '==', ...) 整個查詢會被拒絕、訪客訂單永遠查不到
    function canListOrder(data) {
      return signedIn() && (
        data.get('userId', '') == request.auth.uid
        || (request.auth.token.get('email', '') != ''
            && request.auth.token.get('email_verified', false) == true
            && data.customer.email == request.auth.token.email)
        || (request.auth.token.get('phone_number', '') != ''
            && data.customer.phone == myPhone())
      );
    }

    // ---------- 網站設定：公告、分類、布告欄、花藝小知識、訂購設定 ----------
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- 商品 ----------
    match /products/{productId} {
      allow read: if true;
      // 顧客結帳時扣可預訂數量改由 Cloud Function（functions/create-order.js）處理，
      // 伺服器端的 Admin SDK 不受規則限制；網頁端只有管理員能修改商品
      allow write: if isAdmin();
    }

    // ---------- 訂單 ----------
    match /orders/{orderId} {
      // 用訂單 ID 讀單筆：訂單完成頁（訪客也要能讀到自己剛下的單）。
      // 訂單 ID 是 20 碼隨機字串，無法猜測；列表查詢（list）則只能查自己的
      allow get: if true;
      allow list: if isAdmin() || canListOrder(resource.data);

      // 下單一律透過 Cloud Function（functions/create-order.js 的 createOrder）：
      // 金額、運費、日期、庫存都在伺服器端計算與檢查，網頁端不能直接建立訂單，
      // 避免有人繞過網站送出自訂價格的訂單
      allow create: if false;

      // 網頁端完全不能寫訂單。顧客追加備註、回報匯款一律走 Cloud Function
      // appendOrderNote（functions/append-order-note.js），它只會「往後接」，
      // 不會覆蓋既有備註。
      //
      // 以前這裡有一條「沒有 userId 的訂單，只改 notes 就放行」的例外，是為了讓
      // 訂單完成頁的訪客能回報匯款。但那條例外連登入都不要求，任何人只要知道
      // 訪客訂單的 ID（會從瀏覽紀錄、截圖外流）就能整段覆寫該訂單的備註——
      // 抹掉顧客填好的匯款資訊，或塞一個假的【匯款確認】標記進去。
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- 會員資料 ----------
    match /users/{uid} {
      allow read, write: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // ---------- 聯絡我們的訊息 ----------
    // 誰都可以留言（訪客也行），所以欄位和長度都要擋（2026-10）：以前只檢查 read／reply／userId，
    // 任何人都能塞進任意欄位（例如假的 status、repliedAt）、每則最大 1MB 的內容，灌爆後台訊息列表。
    // 欄位跟 contact.html 送出的一致；長度跟表單的 maxlength 一致
    function validNewMessage(d) {
      return d.keys().hasOnly(['name', 'email', 'phone', 'subject', 'message', 'createdAt', 'read', 'userId'])
        && d.keys().hasAll(['name', 'email', 'subject', 'message', 'createdAt', 'read'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 50
        && d.email is string && d.email.size() <= 100
        && d.get('phone', '') is string && d.get('phone', '').size() <= 20
        && d.subject is string && d.subject.size() <= 50
        && d.message is string && d.message.size() > 0 && d.message.size() <= 2000
        && d.createdAt == request.time
        && d.read == false;
    }

    match /messages/{messageId} {
      allow create: if validNewMessage(request.resource.data)
        && (!('userId' in request.resource.data)
            || (signedIn() && request.resource.data.userId == request.auth.uid));
      allow read: if isAdmin() || (signedIn() && resource.data.get('userId', '') == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // 其他集合一律只有管理員。
    //
    // 這條也涵蓋了 rateLimits（createOrder 的下單頻率計數，見
    // functions/create-order.js）。那個集合只有 Cloud Function 會用，
    // Admin SDK 不受規則限制，所以不要為它開任何網頁端權限——
    // 開了的話攻擊者就能自己把計數歸零，頻率限制等於沒有。
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
