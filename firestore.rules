rules_version = '2';

// Mes Fleurs 芳澤秀花藝設計 - Firestore 安全規則
// 部署：firebase deploy --only firestore:rules（或貼到 Firebase Console → Firestore → 規則）
// 管理員 = Firebase Auth custom claim admin: true（用 GitHub Actions「設定管理員權限」設定）
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // 只改了指定的欄位
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // 登入者的手機號碼（+8869xxxxxxxx → 09xxxxxxxx，跟訂單上存的格式一致）
    function myPhone() {
      return request.auth.token.phone_number.replace('^\\+886', '0');
    }

    // 這筆訂單是不是目前登入者的（會員訂單看 userId；訪客訂單用信箱或手機比對）
    function ownsOrder(data) {
      return signedIn() && (
        data.get('userId', '') == request.auth.uid
        || (!('userId' in data) && request.auth.token.get('email', '') != ''
            && data.customer.email == request.auth.token.email)
        || (!('userId' in data) && request.auth.token.get('phone_number', '') != ''
            && data.customer.phone == myPhone())
      );
    }

    // ---------- 網站設定：公告、分類、布告欄、花藝小知識、訂購設定 ----------
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- 商品 ----------
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // 顧客結帳時（payment.html 的 transaction）只能扣可預訂數量，不能改其他欄位、不能扣到負數
      allow update: if isAdmin() || (
        onlyChanges(['stock', 'lastUpdated'])
        && resource.data.status == 'active'
        && request.resource.data.stock < resource.data.stock
        && request.resource.data.stock >= 0
      );
    }

    // ---------- 訂單 ----------
    match /orders/{orderId} {
      // 用訂單 ID 讀單筆：訂單完成頁（訪客也要能讀到自己剛下的單）。
      // 訂單 ID 是 20 碼隨機字串，無法猜測；列表查詢（list）則只能查自己的
      allow get: if true;
      allow list: if isAdmin() || ownsOrder(resource.data);

      // 下單：只能建立「未付款」訂單；會員訂單的 userId 必須是自己
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.paymentConfirmed == false
        && (!('userId' in request.resource.data)
            || (signedIn() && request.resource.data.userId == request.auth.uid))
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && !('stockRestored' in request.resource.data)
        && !('paymentConfirmedEmailSentAt' in request.resource.data)
        && !('shippedEmailSentAt' in request.resource.data);

      // 顧客只能追加備註（回報匯款、補充需求），不能改金額、狀態或付款確認
      allow update: if isAdmin() || (
        onlyChanges(['notes'])
        && (!('userId' in resource.data)
            || (signedIn() && resource.data.userId == request.auth.uid))
      );
      allow delete: if isAdmin();
    }

    // ---------- 會員資料 ----------
    match /users/{uid} {
      allow read, write: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // ---------- 聯絡我們的訊息 ----------
    match /messages/{messageId} {
      allow create: if request.resource.data.get('read', false) == false
        && !('reply' in request.resource.data)
        && (!('userId' in request.resource.data)
            || (signedIn() && request.resource.data.userId == request.auth.uid));
      allow read: if isAdmin() || (signedIn() && resource.data.get('userId', '') == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // 其他集合一律只有管理員
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
